---
import { footerGroups } from '@/data/nav';
import Icon from '../ui/Icon.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-line-soft bg-deep">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[1.3fr_repeat(3,1fr)] md:py-16">
    <div>
      <span class="inline-flex rounded-[12px] bg-white px-3 py-2"><img src="/logos/blue-cloud.webp" alt="Blue Cloud Softech Solutions Limited" class="h-9 w-auto" loading="lazy" /></span>
      <p class="mt-4 max-w-xs text-small text-ink-3">SMARTAPPS by Blue Cloud Softech Solutions Ltd. Think Big | AI-First.</p>
      <ul class="mt-5 space-y-2 text-small">
        <li><a href="mailto:smartapps@bluecloudsoftech.com" class="inline-flex items-center gap-2 text-ink-2 no-underline hover:text-white"><Icon name="mail" size={15} />smartapps@bluecloudsoftech.com</a></li>
        <li><a href="tel:+917259002609" class="inline-flex items-center gap-2 text-ink-2 no-underline hover:text-white"><Icon name="phone" size={15} />+91 72590 02609</a></li>
        <li><a href="https://bluecloudsoftech.com" class="inline-flex items-center gap-2 text-ink-2 no-underline hover:text-white"><Icon name="arrow-up-right" size={15} />bluecloudsoftech.com</a></li>
      </ul>
    </div>
    {footerGroups.map((g) => (
      <nav aria-label={g.heading}>
        <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">{g.heading}</p>
        <ul class="mt-3 space-y-1.5 text-small">
          {g.links.map((l) => <li><a href={l.href} class="text-ink-2 no-underline hover:text-white hover:underline">{l.label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line-soft">
    <p class="wrap py-5 text-label text-ink-3">© {year} Blue Cloud Softech Solutions Ltd.</p>
  </div>
</footer>
