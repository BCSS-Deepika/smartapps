---
import MainLayout from '@/layouts/MainLayout.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---
<MainLayout title="SmartApps 2.0 (in progress)" description="SmartApps 2.0 rebuild in progress." noindex>
  <Section tone="deep">
    <p class="eyebrow">SmartApps 2.0</p>
    <h1 class="mt-3 text-page">The new homepage arrives at Gate 3.</h1>
    <p class="mt-4 max-w-xl text-lede text-ink-2">This build holds the design system for review. The live site is unchanged.</p>
    <div class="mt-8"><Button href="/design-system/" icon="arrow-right">Open the design system</Button></div>
  </Section>
</MainLayout>
