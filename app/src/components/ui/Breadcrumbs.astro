---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-ink-3">
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="opacity-50">/</span>}
        {it.href ? <a href={it.href} class="text-ink-2 no-underline hover:text-white hover:underline">{it.label}</a> : <span aria-current="page" class="font-semibold text-white">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
