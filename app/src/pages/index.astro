<style>
  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-ink);
  }
  .field :is(input, select, textarea) {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    border-radius: 10px;
    border: 1px solid var(--color-line);
    background: var(--color-bg-alt);
    padding: 10px 12px;
    font: inherit;
    font-weight: 400;
    color: var(--color-ink);
  }
  .field textarea {
    min-height: 96px;
    resize: vertical;
  }
  .field :is(input, select, textarea):focus {
    outline: 2px solid var(--color-brand-soft);
    outline-offset: 1px;
    border-color: transparent;
  }
  .field input[aria-invalid='true'] {
    border-color: var(--color-proposed);
  }
  .field ::placeholder {
    color: var(--color-ink-3);
    opacity: 0.8;
  }
  .err {
    font-weight: 500;
    font-size: var(--text-label);
    color: var(--color-proposed);
  }
  .err:empty {
    display: none;
  }
</style>

<script>
  /* ---------- Workflow tabs: click, arrow keys, and #sc1–#sc4 / #sct1–#sct4 in the URL ---------- */
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tabs] [role="tab"]'));
  const select = (t: HTMLButtonElement, focus = false) => {
    tabs.forEach((o) => {
      const on = o === t;
      o.setAttribute('aria-selected', String(on));
      o.tabIndex = on ? 0 : -1;
      const p = document.getElementById(o.getAttribute('aria-controls')!);
      if (p) p.hidden = !on;
    });
    if (focus) t.focus();
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const n = tabs.length;
      const j = {
        ArrowRight: i + 1,
        ArrowDown: i + 1,
        ArrowLeft: i - 1 + n,
        ArrowUp: i - 1 + n,
        Home: 0,
        End: n - 1,
      }[e.key];
      if (j === undefined) return;
      e.preventDefault();
      select(tabs[j % n], true);
    });
  });
  const fromHash = () => {
    const id = location.hash.slice(1);
    if (!id) return;
    const t = tabs.find((o) => o.id === id || o.getAttribute('aria-controls') === id);
    if (t) {
      select(t);
      document.getElementById('scenarios')?.scrollIntoView();
    }
  };
  window.addEventListener('hashchange', fromHash);
  fromHash();

  /* ---------- Enquiry: same mailto and copy text as the live page ---------- */
  const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
  const text = () =>
    [
      'Platform of interest: ' + v('eProduct'),
      'Name: ' + v('eName'),
      'Organisation: ' + v('eOrg'),
      'Email: ' + v('eMail'),
      'Phone: ' + (v('ePhone') || '—'),
      '',
      'What we are trying to change:',
      v('eMsg') || '—',
    ].join('\n');
  const err = (field: string, box: string, msg: string) => {
    document.getElementById(box)!.textContent = msg;
    document.getElementById(field)!.setAttribute('aria-invalid', msg ? 'true' : 'false');
  };
  const validate = () => {
    let ok = true;
    if (!v('eName').trim()) {
      err('eName', 'errName', 'Enter your name first');
      ok = false;
    } else err('eName', 'errName', '');
    const m = v('eMail').trim();
    if (!m || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(m)) {
      err('eMail', 'errMail', 'Enter a valid email address');
      ok = false;
    } else err('eMail', 'errMail', '');
    if (!ok) (document.querySelector('[aria-invalid="true"]') as HTMLElement | null)?.focus();
    return ok;
  };
  document.getElementById('eName')!.addEventListener('input', () => err('eName', 'errName', ''));
  document.getElementById('eMail')!.addEventListener('input', () => err('eMail', 'errMail', ''));
  document.getElementById('enqForm')!.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!validate()) return;
    const subject = 'SmartApps demonstration request — ' + v('eProduct');
    window.location.href =
      'mailto:smartapps@bluecloudsoftech.com?subject=' +
      encodeURIComponent(subject) +
      '&body=' +
      encodeURIComponent(text());
  });
  document.getElementById('copyEnq')!.addEventListener('click', () => {
    if (!validate()) return;
    const ok = document.getElementById('enqOk')!;
    const done = () => {
      ok.hidden = false;
      setTimeout(() => (ok.hidden = true), 3200);
    };
    if (navigator.clipboard?.writeText) navigator.clipboard.writeText(text()).then(done, () => {});
    else {
      const ta = document.createElement('textarea');
      ta.value = text();
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        done();
      } catch {
        /* nothing to do */
      }
      ta.remove();
    }
  });
</script>
