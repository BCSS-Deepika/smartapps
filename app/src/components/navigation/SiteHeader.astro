---
import { nav } from '@/data/nav';
import { accentStyle } from '@/lib/accent';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
const current = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-line-soft bg-bg/85 backdrop-blur-md" data-site-header>
  <div class="wrap relative flex h-[var(--nav-h)] items-center gap-4">
    <a href="/" class="flex min-w-0 items-center gap-2.5 no-underline" aria-label="SmartApps home">
      <span class="grid size-9 place-items-center rounded-[9px] bg-white p-1"><img src="/logos/blue-cloud-mark.webp" alt="" class="size-full object-contain" /></span>
      <span class="leading-tight">
        <b class="block font-display text-[0.95rem] font-bold tracking-wide text-white">SMARTAPPS</b>
        <span class="block font-mono text-[0.625rem] uppercase tracking-[0.14em] text-ink-3">by Blue Cloud Softech</span>
      </span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {nav.map((item, i) => (
          <li class={item.mega ? '' : 'relative'} data-menu>
            {item.href ? (
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}
                 class="inline-flex min-h-10 items-center rounded-lg px-3 text-small font-medium text-ink-2 no-underline transition-colors hover:bg-white/5 hover:text-white aria-[current=page]:text-white">{item.label}</a>
            ) : (
              <>
                <button type="button" aria-expanded="false" aria-controls={`menu-${i}`} data-menu-btn
                  class="inline-flex min-h-10 items-center gap-1 rounded-lg px-3 text-small font-medium text-ink-2 transition-colors hover:bg-white/5 hover:text-white aria-expanded:bg-white/5 aria-expanded:text-white">
                  {item.label}<Icon name="chevron-down" size={14} class="opacity-70 transition-transform [[aria-expanded=true]>&]:rotate-180" />
                </button>
                <div id={`menu-${i}`} hidden data-menu-panel
                  class={`absolute ${item.mega ? 'top-full' : 'top-[calc(100%+10px)]'} rounded-card border border-line bg-surface p-3 shadow-raised ${item.mega ? 'right-[var(--gutter)] w-[min(1060px,calc(100%-2*var(--gutter)))]' : 'left-0 w-80'}`}>
                  <div class={item.mega ? 'grid grid-cols-[1.15fr_1fr_1fr_1fr] gap-x-2' : ''}>
                    {(item.columns ?? [item.groups!.map((_, gi) => gi)]).map((col, ci) => (
                      <div class={item.mega && ci === 0 ? 'rounded-[10px] bg-bg-alt p-1' : ''}>
                        {col.map((gi) => { const g = item.groups![gi]; return (
                          <div class="mb-1">
                            <p class="px-3 pb-1 pt-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">{g.heading}</p>
                            <ul>
                              {g.links.map((l) => (
                                <li>
                                  <a href={l.href} style={l.accent ? accentStyle(l.accent) : undefined}
                                     class="flex gap-3 rounded-lg px-3 py-2 no-underline transition-colors hover:bg-white/5">
                                    <span class="mt-1.5 size-2 shrink-0 rounded-full bg-[var(--accent,var(--color-ink-3))]" aria-hidden="true"></span>
                                    <span><b class="block text-small font-semibold text-white">{l.label}</b>{l.note && <span class="block text-[0.8125rem] leading-snug text-ink-3">{l.note}</span>}</span>
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ); })}
                      </div>
                    ))}
                  </div>
                </div>
              </>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 lg:ml-3">
      <span class="hidden sm:block"><Button href="/#contact" size="sm">Request a demonstration</Button></span>
      <button type="button" class="grid size-10 place-items-center rounded-lg border border-line text-ink-2 hover:text-white" aria-label="Enter presentation mode" title="Presentation mode" data-present-btn>
        <Icon name="presentation" size={18} />
      </button>
      <button type="button" class="grid size-10 place-items-center rounded-lg border border-line text-ink-2 hover:text-white lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="drawer" data-drawer-open>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

</header>

<!-- mobile drawer: outside the header, whose backdrop blur would trap a fixed child -->
  <div id="drawer" hidden data-drawer class="fixed inset-0 z-50 lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="absolute inset-0 bg-deep/70" data-drawer-close></div>
    <div class="absolute inset-y-0 right-0 flex w-[min(400px,100%)] flex-col border-l border-line bg-bg">
      <div class="flex h-[var(--nav-h)] items-center justify-between border-b border-line-soft px-4">
        <span class="font-display font-bold text-white">Menu</span>
        <button type="button" class="grid size-10 place-items-center rounded-lg border border-line text-ink-2" aria-label="Close menu" data-drawer-close><Icon name="close" size={20} /></button>
      </div>
      <nav aria-label="Main" class="flex-1 overflow-y-auto overscroll-contain p-3">
        <ul class="space-y-1">
          {nav.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href} class="flex min-h-12 items-center rounded-lg px-3 font-medium text-white no-underline hover:bg-white/5">{item.label}</a>
              ) : (
                <details class="group rounded-lg open:bg-surface">
                  <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between rounded-lg px-3 font-medium text-white hover:bg-white/5 [&::-webkit-details-marker]:hidden">
                    {item.label}<Icon name="chevron-down" size={16} class="text-ink-3 transition-transform group-open:rotate-180" />
                  </summary>
                  <div class="px-1 pb-2">
                    {item.groups!.map((g) => (
                      <div>
                        <p class="px-3 pb-1 pt-3 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">{g.heading}</p>
                        <ul>{g.links.map((l) => (
                          <li><a href={l.href} style={l.accent ? accentStyle(l.accent) : undefined} class="flex min-h-11 items-center gap-3 rounded-lg px-3 py-2 text-small text-ink-2 no-underline hover:bg-white/5 hover:text-white">
                            <span class="size-2 shrink-0 rounded-full bg-[var(--accent,var(--color-ink-3))]" aria-hidden="true"></span>{l.label}</a></li>
                        ))}</ul>
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <div class="border-t border-line-soft p-4"><Button href="/#contact" class="w-full">Request a demonstration</Button></div>
    </div>
  </div>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]')!;
  const btns = [...header.querySelectorAll<HTMLButtonElement>('[data-menu-btn]')];
  const close = (except?: HTMLButtonElement) =>
    btns.forEach((b) => { if (b !== except) { b.setAttribute('aria-expanded', 'false'); document.getElementById(b.getAttribute('aria-controls')!)!.hidden = true; } });
  btns.forEach((b) => b.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = b.getAttribute('aria-expanded') !== 'true';
    close(b);
    b.setAttribute('aria-expanded', String(open));
    document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
  }));
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('[data-menu-panel]')) close(); });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const openBtn = btns.find((b) => b.getAttribute('aria-expanded') === 'true');
    close(); openBtn?.focus(); closeDrawer();
  });

  // Mobile drawer: locks page scroll, closes on Escape, on backdrop and after a link is chosen.
  const drawer = document.querySelector<HTMLElement>('[data-drawer]')!;
  const opener = header.querySelector<HTMLButtonElement>('[data-drawer-open]')!;
  function closeDrawer() {
    if (drawer.hidden) return;
    drawer.hidden = true; document.documentElement.style.overflow = ''; opener.setAttribute('aria-expanded', 'false'); opener.focus();
  }
  opener.addEventListener('click', () => {
    drawer.hidden = false; document.documentElement.style.overflow = 'hidden'; opener.setAttribute('aria-expanded', 'true');
    drawer.querySelector<HTMLElement>('[data-drawer-close]:not(div)')?.focus();
  });
  drawer.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));
  matchMedia('(min-width: 1024px)').addEventListener('change', (m) => { if (m.matches) closeDrawer(); });
</script>
