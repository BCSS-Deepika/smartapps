---
/* Feature panel: a larger raised surface for an ecosystem view, a demo or a call to action. */
interface Props { glow?: boolean; class?: string }
const { glow = false, class: cls = '' } = Astro.props;
---
<div class={`relative overflow-hidden rounded-panel border border-line bg-gradient-to-br from-surface to-bg-alt p-6 md:p-10 ${cls}`}>
  {glow && <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-brand/15 blur-3xl"></div>}
  <div class="relative"><slot /></div>
</div>
