---
/* One figure in a <dl> of figures. The label is the term and the figure its value; the figure
   still shows first. */
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<div class="flex flex-col-reverse justify-end">
  <dt class="mt-2 text-small text-ink-3">{label}</dt>
  <dd class="font-display text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-none text-brand-soft">{value}</dd>
</div>
