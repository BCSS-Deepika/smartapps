---
import { logoSize } from '@/lib/logos';
/* Product logos are drawn for white backgrounds, so they always sit on a white plate. */
interface Props { src: string; alt: string; height?: number; class?: string }
const { src, alt, height = 40, class: cls = '' } = Astro.props;
const [w, h] = logoSize[src] ?? [height, height];
const width = Math.round((w / h) * height);
---
<span class={`inline-flex items-center justify-center rounded-[12px] bg-white px-3 py-2 ${cls}`}>
  <img src={src} alt={alt} width={width} height={height} style={`height:${height}px; width:${width}px`} class="max-w-full object-contain" loading="lazy" decoding="async" />
</span>
