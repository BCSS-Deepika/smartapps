---
import Icon, { type IconName } from './Icon.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'sm';
  icon?: IconName;
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', icon, type = 'button', external, class: cls = '', ...rest } = Astro.props;
const base = 'group inline-flex items-center justify-center gap-2 font-sans font-semibold rounded-btn transition-[background-color,border-color,color,box-shadow,transform] duration-200 ease-out select-none disabled:opacity-50 disabled:pointer-events-none';
const sizes = { md: 'min-h-12 px-5 text-[0.9375rem]', sm: 'min-h-10 px-3.5 text-small' };
const variants = {
  primary: 'bg-brand text-brand-ink shadow-brand hover:bg-brand-hover active:translate-y-px',
  secondary: 'border border-line bg-white/[0.03] text-white hover:border-ink-3 hover:bg-white/[0.07]',
  ghost: 'text-sky hover:text-white px-1.5',
};
const classes = [base, sizes[size], variants[variant], cls].join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag
  class={classes}
  href={href}
  type={href ? undefined : type}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
  {icon && <Icon name={icon} size={17} class="transition-transform duration-200 group-hover:translate-x-0.5" />}
</Tag>
