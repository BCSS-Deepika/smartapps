---
import { footerGroups } from '@/data/nav';
import Icon from '../ui/Icon.astro';
const year = new Date().getFullYear();
const facts = [
  'Founded 1991',
  'Hyderabad',
  '10 countries',
  'BSE + NSE listed',
  'ISO 9001:2015',
  'ISO 27001:2022',
];
---

<footer class="border-t border-line-soft bg-deep" data-site-footer>
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 md:py-16 lg:grid-cols-[1.4fr_1.2fr_1fr_1fr]">
    <div class="md:col-span-2 lg:col-span-1">
      <span class="inline-flex rounded-[12px] bg-white px-3 py-2">
        <img
          src="/logos/blue-cloud.webp"
          alt="Blue Cloud Softech Solutions Limited"
          class="h-12 w-auto"
          width="214"
          height="48"
          loading="lazy"
        />
      </span>
      <p class="mt-4 font-display font-semibold text-white">SmartApps portfolio</p>
      <p class="mt-2 max-w-sm text-small text-ink-3">
        An integrated solutions portfolio by Blue Cloud Softech Solutions Limited — AI video and IoT
        intelligence for public safety, government, enterprise and education.
      </p>
      <ul class="mt-5 flex flex-wrap gap-1.5">
        {facts.map((f) => (
          <li class="rounded-chip border border-line bg-surface px-2 py-1 font-mono text-[0.6875rem] text-ink-2">
            {f}
          </li>
        ))}
      </ul>
    </div>
    {[footerGroups[0], [footerGroups[1], footerGroups[2]], footerGroups[3]].map((col) => (
      <div class="space-y-8">
        {(Array.isArray(col) ? col : [col]).map((g) => (
          <nav aria-label={g.heading}>
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-ink-3">
              {g.heading}
            </p>
            <ul class="mt-3 space-y-1.5 text-small">
              {g.links.map((l) => (
                <li>
                  <a href={l.href} class="text-ink-2 no-underline hover:text-white hover:underline">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    ))}
  </div>
  <div class="border-t border-line-soft">
    <div class="wrap flex flex-col gap-3 py-5 text-label text-ink-3 md:flex-row md:items-center md:justify-between">
      <p>© {year} Blue Cloud Softech Solutions Limited. All rights reserved.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li>
          <a
            href="mailto:smartapps@bluecloudsoftech.com"
            class="inline-flex items-center gap-1.5 text-ink-2 no-underline hover:text-white"
          >
            <Icon name="mail" size={14} />
            smartapps@bluecloudsoftech.com
          </a>
        </li>
        <li>
          <a
            href="tel:+917259002609"
            class="inline-flex items-center gap-1.5 text-ink-2 no-underline hover:text-white"
          >
            <Icon name="phone" size={14} />
            +91 72590 02609
          </a>
        </li>
        <li>
          <a
            href="https://bluecloudsoftech.com"
            class="inline-flex items-center gap-1.5 text-ink-2 no-underline hover:text-white"
          >
            <Icon name="arrow-up-right" size={14} />
            bluecloudsoftech.com
          </a>
        </li>
      </ul>
    </div>
    <p class="wrap pb-6 text-label text-ink-3">
      Deployment figures are drawn from specific live deployments and are stated as reference
      information, not as guarantees. Integrations are scoped, tested and approved per deployment;
      capabilities marked as proposed have not been validated against a production system.
    </p>
  </div>
</footer>
